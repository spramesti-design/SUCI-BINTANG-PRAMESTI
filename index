$("hintb").onclick=()=>{
 if(!G||G.over)return;
 const left=G.placed.filter(p=>!p.found);if(!left.length)return;
 const p=left[Math.random()*left.length|0],c=G.cells[p.r*G.n+p.c];
 c.classList.add("hint");setTimeout(()=>c.classList.remove("hint"),1900);
};
$("back").onclick=menu;
$("menu").addEventListener("click",e=>{
 const b=e.target.closest("button");if(!b)return;
 if(b.dataset.l){lang=b.dataset.l;try{localStorage.setItem("ws-lang",lang)}catch(x){}document.documentElement.lang=lang;menu()}
 else if(b.dataset.d!==undefined)start(+b.dataset.d,true);
 else if(b.dataset.e!==undefined)start(+b.dataset.e,false);
});
document.documentElement.lang=lang;
menu();
